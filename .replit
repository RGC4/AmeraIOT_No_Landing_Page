modules = ["nodejs-20", "python-3.11"]
[nix]
channel = "stable-25_05"

[agent]
expertMode = true
integrations = ["github:1.0.0"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "structured-data"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "security-audit"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "csp-report"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "structured-data-validators"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "legacy-redirects"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "structured-data"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run check:structured-data"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "security-audit"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run audit:security"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "csp-report"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run check:csp-report"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "structured-data-validators"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run check:structured-data:validators"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "legacy-redirects"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run check:legacy-redirects"

[workflows.workflow.metadata]
isValidation = true

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5199
externalPort = 3002

[[ports]]
localPort = 23636
externalPort = 4200

[objectStorage]
defaultBucketID = "replit-objstore-a94a160c-6bad-4323-ae82-ada76546e49f"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[deployment]
deploymentTarget = "autoscale"
run = ["npm", "run", "start"]
build = ["npm", "run", "build"]
