# Environment variable template.
# Copy this file to `.env` and fill in real values.
# The real `.env` is gitignored and must NEVER be committed.
#
# NOTE: The /news feed (src/app/api/news/route.ts) needs NO API key —
# it aggregates only public RSS/Atom feeds (Google News, BleepingComputer,
# The Hacker News, CISA, Schneier on Security). Nothing below is required
# for the news feed to work.

# --- Supabase (only if you wire up Supabase) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- AI providers (only if you add AI features) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=

# --- Analytics / Ads (only if you enable them) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_ADSENSE_ID=

# --- Stripe (only if you add payments) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Security: CSP violation alerts (optional) ---
# Webhook URL that CSP violation reports are forwarded to so blocked resources
# raise a visible alert instead of only landing in the logs. Accepts a Slack or
# Discord incoming-webhook URL, or any generic collector. Treat as a SECRET
# (set it in Vercel / Replit secrets, never commit a real value). When unset,
# reports are still written to the server logs. See SECURITY.md.
CSP_REPORT_WEBHOOK_URL=
